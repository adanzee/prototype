# Model chain: first is primary, the rest are fallbacks (JSON list)
LLM_MODEL="any llm model you are using "
LLM_FALLBACK_MODELS=["groq/llama-3.3-70b-versatile"]

# Provider keys are read by LiteLLM from the environment
GEMINI_API_KEY=
GROQ_API_KEY=

MAX_BRIEF_CHARS=20000

# Leave empty to use the in-memory checkpointer
DATABASE_URL=